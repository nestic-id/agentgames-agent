# Agent Games agent service — copy to .env and fill in. Secrets come from the
# platform dashboard (Rotate Secret) and kurier.xyz. NEVER commit a filled .env.

# --- service ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- platform HMAC (dashboard -> agent -> Rotate Secret; shown once) ---
AGENT_GAMES_HMAC_SECRET=
# UNVERIFIED digest/encoding (SPEC S3) — defaults are the best guess; the
# verifier also accepts the alternate encoding and logs which one matched.
HMAC_ALGO=sha256
HMAC_ENCODING=hex
HMAC_ACCEPT_ALT=true

# --- storage ---
DATA_DIR=./data
SEEN_FILE=seen-proof-tx.json
# PROOF_REUSED rule: "accepted" = SPEC S4.3 wording (proof_tx of APPROVED
# tasks only) | "all" = any previously processed proof_tx.
SEEN_RULE=accepted

# --- Gatekeeper ---
APPROVE_REASON_CODE=VALID_CONDITION
DECISION_APPROVE_VALUE=1
DECISION_REJECT_VALUE=0
GATEKEEPER_SALT=0
GK_RESPOND_BY_MS=50000

# --- Kurier (zkVerify submission; free API key from kurier.xyz) ---
KURIER_API_KEY=
KURIER_BASE_URL=https://api.kurier.xyz/api/v1
KURIER_WAIT_BUDGET_MS=40000
# Kurier runs in the BACKGROUND since 15 Nov 2026: responses never wait
# for finalization. This only bounds how long a response may race the
# initial submit call to harvest a reference it carries (Steal).
KURIER_SUBMIT_RACE_MS=1500
KURIER_POLL_INTERVAL_MS=2000
KURIER_REQUEST_TIMEOUT_MS=10000
PROOF_TIMEOUT_MS=30000

# --- Steal the VFY ---
STRATEGY_SALT=
STRATEGY_PARAMS=
POSEIDON_INPUT_ORDER=paramsThenSalt
FORTIFY_BLOCKS=false
STEAL_EXTRACT_CAP=10
STEAL_FORTIFY_COST=2
STEAL_RESPOND_BY_MS=25000
# true = strict fail-closed HOLD when the policy proof cannot be produced;
# false = return the policy action without a proof (platform scores it as
# HOLD-with-no-proof either way). See README "Failure modes".
STEAL_PROOF_REQUIRED=false
