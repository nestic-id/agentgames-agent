# Vercel port — environment variable NAMES (values go in the Vercel
# project settings; never commit real values). Same names as the live
# agent where the ported logic uses them.

# Required
AGENT_GAMES_HMAC_SECRET=

# HMAC (defaults match the live agent)
HMAC_ALGO=sha256
HMAC_ENCODING=hex
HMAC_ACCEPT_ALT=true
HMAC_HEADER=x-agent-games-signature

# Gatekeeper (defaults match the live agent)
APPROVE_REASON_CODE=VALID_CONDITION
FALLBACK_REJECT_REASON_CODE=INVALID_INPUT
SEEN_RULE=accepted
DECISION_APPROVE_VALUE=1
DECISION_REJECT_VALUE=0
GATEKEEPER_SALT=
GK_RESPOND_BY_MS=50000
PROOF_TIMEOUT_MS=30000

# Steal the VFY (defaults match the live agent)
# STRATEGY_PARAMS uses the LIVE format: a JSON array of 8 numbers,
# e.g. "[10,70,0,0,0,0,0,0]" — set the SAME value as the live agent.
STRATEGY_SALT=
STRATEGY_PARAMS=
STEAL_RESPOND_BY_MS=25000
STEAL_PROOF_REQUIRED=false

# Seen-store: auto (Blob when BLOB_READ_WRITE_TOKEN is set, else memory)
# | blob | memory | file (file is local-only, needs SEEN_FILE_PATH)
SEEN_BACKEND=auto
BLOB_READ_WRITE_TOKEN=
SEEN_FILE_PATH=

LOG_LEVEL=info
